# Blender + Sollumz
BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.5\blender.exe
SOLLUMZ_ADDON_PATH=C:\Users\YOU\AppData\Roaming\Blender Foundation\Blender\4.5\scripts\addons\Sollumz
SOLLUMZ_ADDON_MODULE=Sollumz

# Worker HTTP
ISLAND_EXPORT_BRIDGE_TOKEN=replace-with-a-long-random-secret
ISLAND_EXPORT_BRIDGE_PORT=8787
ISLAND_WORKER_DATA=D:\IslandForge\jobs
ISLAND_WORKER_MAX_BODY=268435456
ISLAND_WORKER_MAX_QUEUE=8
ISLAND_WORKER_MAX_PROP_ENTITIES=5000

# Optional real diffuse/normal texture overrides
GUNWARE_TEXTURE_DIR=D:\IslandForge\textures
